# ============================================================
#  StockEz production secrets — copy to `.env` and fill in.
#  Generate strong secrets with:  openssl rand -base64 36
#  NEVER commit the real .env to git.
# ============================================================

# --- Database ---
DB_NAME=stockez
DB_USERNAME=stockez
DB_PASSWORD=CHANGE_ME_strong_random          # openssl rand -base64 24

# --- Auth ---
JWT_SECRET=CHANGE_ME_min_64_chars_random      # openssl rand -base64 48

# --- Super admin (platform login) ---
SUPER_ADMIN_PHONE=9384745303
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong

# --- Cloudflare R2 (ROTATE these — the old keys were on the hacked server) ---
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_NEW_r2_access_key
R2_SECRET_KEY=your_NEW_r2_secret_key
R2_BUCKET=stockez-images
R2_PUBLIC_URL=https://your-r2-public-url

# --- Public URL ---
BASE_URL=https://app.stockez.in

# --- Error tracking (optional) ---
SENTRY_DSN=
