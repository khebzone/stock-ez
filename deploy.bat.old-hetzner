@echo off
setlocal
set SERVER=root@178.105.190.214
set ROOT=C:\Users\Kathiravan\Desktop\StockEz

echo.
echo =========================================
echo   StockEz - Deploy to Production
echo =========================================
echo.

echo [1/5] Building frontend...
cd /d "%ROOT%\stockez-web"
call npm run build
if errorlevel 1 (echo FRONTEND BUILD FAILED & pause & exit /b 1)

echo.
echo [2/5] Building backend...
cd /d "%ROOT%\stockez-api"
call .\mvnw.cmd clean package -DskipTests
if errorlevel 1 (echo BACKEND BUILD FAILED & pause & exit /b 1)

cd /d "%ROOT%"

echo.
echo [3/5] Clearing old frontend files on server...
ssh %SERVER% "rm -rf /var/www/stockez/*"

echo.
echo [4/5] Uploading frontend + backend...
scp -r stockez-web\dist\* %SERVER%:/var/www/stockez/
scp stockez-api\target\stockez-api-1.0.0-SNAPSHOT.jar %SERVER%:/opt/stockez/stockez-api.jar

echo.
echo [5/5] Restarting backend...
ssh %SERVER% "systemctl restart stockez"

echo.
echo =========================================
echo   Deploy complete.
echo =========================================
echo.
echo Tip: if you edited the database directly with SQL,
echo also run:  ssh %SERVER% "redis-cli FLUSHALL"
echo.
pause
